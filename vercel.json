{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "skillhub/dist/public",
  "framework": "vite",
  "installCommand": "npm install --no-package-lock",
  "rewrites": [
    { "source": "/api/friends", "destination": "/api/social?route=friends" },
    { "source": "/api/friends/request", "destination": "/api/social?route=request" },
    { "source": "/api/friends/status/:userId", "destination": "/api/social?route=status&userId=:userId" },
    { "source": "/api/friends/:id", "destination": "/api/social?route=update&id=:id" },
    { "source": "/api/groups/:id/join", "destination": "/api/social/join?groupId=:id" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
